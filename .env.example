# Login da equipe. Não é login do Google.
# Sem o prefixo VITE_, a senha fica só no servidor.
# Na Vercel, cadastre ADMIN_EMAIL e ADMIN_PASSWORD em Settings → Environment Variables.
# GOOGLE_REDIRECT_URI em produção é a URL do site, por exemplo
# https://seu-projeto.vercel.app/api/drive/callback
ADMIN_EMAIL=admin@acervo.com.br
ADMIN_PASSWORD=troque-esta-senha

# Conexão da organização com o Google Drive.
# O visitante não entra com Google. O admin autoriza a pasta uma vez
# e o servidor guarda o acesso na tabela drive_conexao do MySQL.
#
# Onde criar as chaves:
# 1. https://console.cloud.google.com/ — crie um projeto.
# 2. Ative "Google Drive API".
# 3. Tela de consentimento OAuth: tipo Externo, em teste.
#    Adicione o e-mail da organização como usuário de teste.
#    Escopo: https://www.googleapis.com/auth/drive
# 4. Credenciais → Criar credenciais → ID do cliente OAuth → Aplicativo da Web.
# 5. Em "URIs de redirecionamento autorizados", cadastre a URL que o app mostra
#    na faixa do Drive (em geral http://localhost:5173/api/drive/callback).
# 6. No Drive, abra a pasta do acervo. O id é o trecho final da URL:
#    https://drive.google.com/drive/folders/ESTE_E_O_ID
# 7. Cole os três valores abaixo, salve e reinicie o `npm run dev`.
# 8. Entre como admin e clique em "Conectar Google Drive".

# MySQL da Hostinger. Ao salvar em Configurações, o servidor cria as tabelas.
# No hPanel, libere este computador em MySQL remoto. O host não é localhost.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_FOLDER_ID=

# Opcional. Se ficar vazio, o app usa o endereço do próprio servidor.
# Tem de ser idêntico ao cadastrado no Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/drive/callback
